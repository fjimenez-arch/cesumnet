---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { sitio } from "../data/sitio.js";

interface Props {
  titulo: string;
  descripcion?: string;
}
const {
  titulo,
  descripcion = "Secundaria y Preparatoria CESUM. Formación académica de excelencia con valores.",
} = Astro.props;

const tituloCompleto = `${titulo} · ${sitio.nombre}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />

    <!-- Open Graph / redes sociales -->
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />

    <!-- Tipografías -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Animación de aparición al hacer scroll -->
    <script>
      const objetos = document.querySelectorAll(".aparece");
      if ("IntersectionObserver" in window && objetos.length) {
        const obs = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("visible");
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        objetos.forEach((o) => obs.observe(o));
      } else {
        objetos.forEach((o) => o.classList.add("visible"));
      }
    </script>
  </body>
</html>
