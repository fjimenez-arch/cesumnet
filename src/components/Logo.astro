---
interface Props {
  /** Color del texto del logo */
  variante?: "azul" | "blanco";
}
const { variante = "azul" } = Astro.props;
const colorTexto = variante === "blanco" ? "#ffffff" : "var(--azul-900)";
---

<a href="/" class="logo" aria-label="Inicio — CESUM">
  <img
    class="logo__mark"
    src="/escudo.jpeg"
    alt="Escudo de CESUM"
    width="33"
    height="46"
    loading="eager"
    decoding="async"
  />
  <span class="logo__texto">
    <strong>CESUM</strong>
    <small>Preescolar a Undécimo</small>
  </span>
</a>

<style define:vars={{ colorTexto }}>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo__mark {
    flex: none;
    height: 46px;
    width: auto;
    display: block;
    background: #fff;
    border-radius: 8px;
    padding: 2px 4px;
  }
  .logo__texto {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .logo__texto strong {
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    color: var(--colorTexto);
  }
  .logo__texto small {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--colorTexto);
    opacity: 0.7;
  }
</style>
