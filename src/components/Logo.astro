---
interface Props {
  /** Color del texto del logo */
  variante?: "azul" | "blanco";
}
const { variante = "azul" } = Astro.props;
const colorTexto = variante === "blanco" ? "#ffffff" : "var(--azul-900)";
---

<a href="/" class="logo" aria-label="Inicio — CESUM">
  <svg class="logo__mark" viewBox="0 0 64 64" width="40" height="40" aria-hidden="true">
    <rect width="64" height="64" rx="14" fill="#0d3b66" />
    <path
      d="M32 16 9 26l23 10 18-7.83V40h4V26L32 16zm0 24.4-13-5.65V40c0 3.9 5.82 7 13 7s13-3.1 13-7v-5.25L32 40.4z"
      fill="#f6b41e"
    />
  </svg>
  <span class="logo__texto">
    <strong>CESUM</strong>
    <small>Secundaria · Preparatoria</small>
  </span>
</a>

<style define:vars={{ colorTexto }}>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo__mark { flex: none; }
  .logo__texto {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .logo__texto strong {
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    color: var(--colorTexto);
  }
  .logo__texto small {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--colorTexto);
    opacity: 0.7;
  }
</style>
