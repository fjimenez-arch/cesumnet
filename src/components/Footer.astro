---
import Logo from "./Logo.astro";
import { sitio } from "../data/sitio.js";
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor pie__grid">
    <div class="pie__col pie__marca">
      <Logo variante="blanco" />
      <p>{sitio.lema}</p>
      <div class="pie__redes">
        {sitio.redes.facebook && (
          <a href={sitio.redes.facebook} target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
          </a>
        )}
        {sitio.redes.instagram && (
          <a href={sitio.redes.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 1.62c-3.15 0-3.5.01-4.74.07-1.14.05-1.76.24-2.17.4-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.41-.35 1.03-.4 2.17-.06 1.24-.07 1.59-.07 4.74s.01 3.5.07 4.74c.05 1.14.24 1.76.4 2.17.21.55.47.94.88 1.35.41.41.8.67 1.35.88.41.16 1.03.35 2.17.4 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c1.14-.05 1.76-.24 2.17-.4.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.41.35-1.03.4-2.17.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.05-1.14-.24-1.76-.4-2.17a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.41-.16-1.03-.35-2.17-.4-1.24-.06-1.59-.07-4.74-.07zm0 2.76a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6zm0 8.74a3.44 3.44 0 1 0 0-6.88 3.44 3.44 0 0 0 0 6.88zm6.74-8.94a1.24 1.24 0 1 1-2.48 0 1.24 1.24 0 0 1 2.48 0z"/></svg>
          </a>
        )}
        {sitio.redes.youtube && (
          <a href={sitio.redes.youtube} target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.12-2.12C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.53A3 3 0 0 0 .5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3 3 0 0 0 2.12 2.12c1.88.53 9.38.53 9.38.53s7.5 0 9.38-.53a3 3 0 0 0 2.12-2.12C24 15.93 24 12 24 12s0-3.93-.5-5.8zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg>
          </a>
        )}
      </div>
    </div>

    <div class="pie__col">
      <h4>Navegación</h4>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/#nosotros">Nosotros</a></li>
        <li><a href="/#oferta">Oferta educativa</a></li>
        <li><a href="/admisiones">Admisiones</a></li>
        <li><a href="/classroom">Aula virtual</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
    </div>

    <div class="pie__col">
      <h4>Aula virtual</h4>
      <ul>
        <li><a href={sitio.workspace.classroom} target="_blank" rel="noopener">Google Classroom</a></li>
        <li><a href={sitio.workspace.correo} target="_blank" rel="noopener">Correo institucional</a></li>
        <li><a href={sitio.workspace.calendario} target="_blank" rel="noopener">Calendario</a></li>
        <li><a href={sitio.workspace.drive} target="_blank" rel="noopener">Drive</a></li>
      </ul>
    </div>

    <div class="pie__col">
      <h4>Contacto</h4>
      <ul class="pie__contacto">
        <li>📍 {sitio.direccion}</li>
        {sitio.telefono && <li>📞 <a href={`tel:${sitio.telefono.replace(/\s/g, "")}`}>{sitio.telefono}</a></li>}
        <li>✉️ <a href={`mailto:${sitio.email}`}>{sitio.email}</a></li>
        <li>🕒 {sitio.horario}</li>
      </ul>
    </div>
  </div>

  <div class="pie__legal">
    <div class="contenedor">
      <span>© {anio} {sitio.nombreLargo}. Todos los derechos reservados.</span>
      <span>{sitio.dominio}</span>
    </div>
  </div>
</footer>

<style>
  .pie {
    background: var(--azul-900);
    color: rgba(255, 255, 255, 0.82);
    padding-top: 3.5rem;
  }
  .pie__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .pie__marca p { margin-top: 1rem; max-width: 30ch; font-size: 0.95rem; }
  .pie h4 {
    color: #fff;
    font-size: 1rem;
    margin-bottom: 1rem;
  }
  .pie ul { list-style: none; padding: 0; display: grid; gap: 0.55rem; }
  .pie ul a { font-size: 0.95rem; transition: color var(--transicion); }
  .pie ul a:hover { color: var(--acento); }
  .pie__contacto li { font-size: 0.92rem; line-height: 1.5; }
  .pie__redes {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .pie__redes a {
    width: 38px; height: 38px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    transition: background var(--transicion), transform var(--transicion);
  }
  .pie__redes a:hover { background: var(--acento); color: var(--azul-900); transform: translateY(-2px); }
  .pie__legal {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: 1.25rem;
    font-size: 0.85rem;
  }
  .pie__legal .contenedor {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  @media (max-width: 820px) {
    .pie__grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }
  @media (max-width: 520px) {
    .pie__grid { grid-template-columns: 1fr; }
  }
</style>
