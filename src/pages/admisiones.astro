---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitio } from "../data/sitio.js";

const pasos = [
  { n: 1, titulo: "Consulta el cupo", texto: "Verifica la disponibilidad de cupos para el grado de interés y la jornada (mañana o tarde)." },
  { n: 2, titulo: "Reúne los documentos", texto: "Prepara los documentos del estudiante y del acudiente (ver la lista de requisitos)." },
  { n: 3, titulo: "Acércate a la institución", texto: "Entrega los documentos en la secretaría o coordinación en las fechas de matrícula." },
  { n: 4, titulo: "Formaliza la matrícula", texto: "Diligencia y firma el formulario de matrícula junto con el acudiente." },
  { n: 5, titulo: "¡Bienvenido a CESUM!", texto: "El estudiante queda registrado y listo para iniciar el año escolar." },
];

const requisitos = [
  "Registro civil de nacimiento (copia)",
  "Documento de identidad del estudiante (tarjeta de identidad o registro civil)",
  "Documento de identidad del acudiente (copia)",
  "Certificados de notas de los años anteriores",
  "Boletín o paz y salvo del año anterior",
  "Copia del carné de vacunas (para preescolar)",
  "Copia de afiliación a EPS o Sisbén",
];

const fechas = [
  { etapa: "Matrículas de estudiantes nuevos", fecha: "Consultar fechas" },
  { etapa: "Renovación de matrícula (antiguos)", fecha: "Consultar fechas" },
  { etapa: "Inicio del año escolar", fecha: "Según calendario académico" },
];
---

<BaseLayout titulo="Matrícula" descripcion="Proceso de matrícula, requisitos y fechas en la Concentración Educativa del Sur de Montelíbano (CESUM). Educación pública y gratuita.">
  <!-- Encabezado de página -->
  <section class="page-hero">
    <div class="contenedor">
      <span class="kicker">Matrícula</span>
      <h1>Tu matrícula en CESUM</h1>
      <p>La matrícula en nuestra institución es <strong>pública y gratuita</strong>. Aquí te explicamos el proceso, los requisitos y los documentos que necesitas.</p>
      <div class="page-hero__acciones">
        <a href="/contacto" class="btn btn--primario">Solicitar información</a>
      </div>
    </div>
  </section>

  <!-- Gratuidad -->
  <section class="seccion">
    <div class="contenedor">
      <div class="grid grid--3">
        <div class="tarjeta aparece">
          <div class="icono">🆓</div>
          <h3>Educación gratuita</h3>
          <p>Como institución pública, no se cobra valor de matrícula ni pensión para estudiar en CESUM.</p>
        </div>
        <div class="tarjeta aparece">
          <div class="icono">🕗</div>
          <h3>Doble jornada</h3>
          <p>Ofrecemos cupos en las jornadas de la mañana y de la tarde, según el grado y la disponibilidad.</p>
        </div>
        <div class="tarjeta aparece">
          <div class="icono">🎒</div>
          <h3>De preescolar a 11°</h3>
          <p>Recibimos estudiantes en todos los niveles: preescolar, básica primaria, secundaria y media.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Proceso paso a paso -->
  <section class="seccion seccion--suave">
    <div class="contenedor">
      <div class="encabezado-seccion aparece">
        <span class="kicker">Proceso</span>
        <h2>5 pasos para matricularte</h2>
      </div>
      <ol class="pasos">
        {pasos.map((p) => (
          <li class="paso aparece">
            <span class="paso__num">{p.n}</span>
            <div>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Requisitos + Fechas -->
  <section class="seccion">
    <div class="contenedor grid grid--2 bloques">
      <div class="tarjeta aparece">
        <div class="icono">📄</div>
        <h3>Documentos para la matrícula</h3>
        <ul class="lista-check">
          {requisitos.map((r) => <li>{r}</li>)}
        </ul>
      </div>
      <div class="tarjeta aparece">
        <div class="icono">📅</div>
        <h3>Fechas importantes</h3>
        <table class="tabla-fechas">
          <tbody>
            {fechas.map((f) => (
              <tr>
                <td>{f.etapa}</td>
                <td>{f.fecha}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="nota">* Confirma las fechas y los cupos vigentes en la secretaría de la institución.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="seccion seccion--azul">
    <div class="contenedor cta">
      <div class="aparece">
        <h2>¿Tienes dudas sobre la matrícula?</h2>
        <p>Comunícate con nosotros y con gusto te orientamos en el proceso.</p>
      </div>
      <div class="aparece">
        <a href="/contacto" class="btn btn--primario">Contáctanos</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(150deg, var(--azul-900), var(--azul-700));
    color: #fff;
    padding-block: clamp(3rem, 7vw, 4.5rem);
    text-align: center;
  }
  .page-hero .kicker {
    color: var(--acento);
    font-family: var(--fuente-titulo);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.82rem;
  }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 5vw, 3rem); margin: 0.6rem 0 0.8rem; }
  .page-hero p { color: rgba(255,255,255,0.88); max-width: 56ch; margin-inline: auto; font-size: 1.08rem; }
  .page-hero__acciones { display: flex; gap: 0.85rem; justify-content: center; flex-wrap: wrap; margin-top: 1.75rem; }

  /* Pasos */
  .pasos { list-style: none; padding: 0; max-width: 760px; margin-inline: auto; display: grid; gap: 1.1rem; }
  .paso {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: #fff;
    border: 1px solid var(--gris-200);
    border-radius: var(--radio);
    padding: 1.5rem;
    transition: box-shadow var(--transicion), border-color var(--transicion);
  }
  .paso:hover { box-shadow: var(--sombra-sm); border-color: var(--azul-300); }
  .paso__num {
    flex: none;
    width: 44px; height: 44px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--azul-700);
    color: #fff;
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .paso h3 { font-size: 1.15rem; margin-bottom: 0.25rem; }
  .paso p { color: var(--gris-700); }

  /* Listas y tablas */
  .bloques .tarjeta { padding: 2rem; }
  .lista-check { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .lista-check li { padding-left: 1.7rem; position: relative; color: var(--gris-700); }
  .lista-check li::before { content: "✓"; position: absolute; left: 0; color: var(--azul-500); font-weight: 700; }

  .tabla-fechas { width: 100%; border-collapse: collapse; }
  .tabla-fechas td { padding: 0.7rem 0; border-bottom: 1px solid var(--gris-200); font-size: 0.96rem; }
  .tabla-fechas td:first-child { color: var(--tinta); font-weight: 500; }
  .tabla-fechas td:last-child { color: var(--azul-600); text-align: right; white-space: nowrap; }
  .nota { font-size: 0.82rem; color: var(--gris-400); margin-top: 1rem; }

  .cta { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .cta h2 { font-size: clamp(1.5rem, 3.5vw, 2rem); }
  .cta p { color: rgba(255,255,255,0.85); margin-top: 0.4rem; }
</style>
