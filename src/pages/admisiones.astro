---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitio } from "../data/sitio.js";

const pasos = [
  { n: 1, titulo: "Solicita informes", texto: "Llena el formulario de contacto o escríbenos. Te enviamos costos y detalles." },
  { n: 2, titulo: "Agenda tu visita", texto: "Conoce nuestras instalaciones y resuelve tus dudas con el equipo de admisiones." },
  { n: 3, titulo: "Examen de admisión", texto: "Presenta el examen diagnóstico (sin costo) para conocer tu nivel académico." },
  { n: 4, titulo: "Entrevista familiar", texto: "Una breve charla con el alumno y los padres o tutores." },
  { n: 5, titulo: "Inscripción", texto: "Entrega de documentos, pago de inscripción y ¡bienvenido a CESUM!" },
];

const requisitos = [
  "Acta de nacimiento (original y copia)",
  "CURP del aspirante",
  "Certificado o boleta del grado anterior",
  "6 fotografías tamaño infantil",
  "Comprobante de domicilio reciente",
  "Identificación del padre, madre o tutor",
];

const fechas = [
  { etapa: "Apertura de inscripciones", fecha: "Febrero 2026" },
  { etapa: "Exámenes de admisión", fecha: "Marzo – Junio 2026" },
  { etapa: "Resultados", fecha: "5 días hábiles después del examen" },
  { etapa: "Inicio de clases", fecha: "Agosto 2026" },
];
---

<BaseLayout titulo="Admisiones" descripcion="Proceso de admisión, requisitos y fechas para Secundaria y Preparatoria CESUM.">
  <!-- Encabezado de página -->
  <section class="page-hero">
    <div class="contenedor">
      <span class="kicker">Admisiones 2026–2027</span>
      <h1>Tu lugar en CESUM te espera</h1>
      <p>Un proceso sencillo y transparente para integrarte a nuestra comunidad de Secundaria y Preparatoria.</p>
      <div class="page-hero__acciones">
        <a href="/contacto" class="btn btn--primario">Solicitar informes</a>
        <a href={`https://wa.me/${sitio.whatsapp}`} target="_blank" rel="noopener" class="btn btn--linea">WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- Proceso paso a paso -->
  <section class="seccion">
    <div class="contenedor">
      <div class="encabezado-seccion aparece">
        <span class="kicker">Proceso</span>
        <h2>5 pasos para ingresar</h2>
      </div>
      <ol class="pasos">
        {pasos.map((p) => (
          <li class="paso aparece">
            <span class="paso__num">{p.n}</span>
            <div>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Requisitos + Fechas -->
  <section class="seccion seccion--suave">
    <div class="contenedor grid grid--2 bloques">
      <div class="tarjeta aparece">
        <div class="icono">📄</div>
        <h3>Requisitos de inscripción</h3>
        <ul class="lista-check">
          {requisitos.map((r) => <li>{r}</li>)}
        </ul>
      </div>
      <div class="tarjeta aparece">
        <div class="icono">📅</div>
        <h3>Fechas importantes</h3>
        <table class="tabla-fechas">
          <tbody>
            {fechas.map((f) => (
              <tr>
                <td>{f.etapa}</td>
                <td>{f.fecha}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="nota">* Fechas de referencia. Confirma el calendario vigente con el área de admisiones.</p>
      </div>
    </div>
  </section>

  <!-- Becas -->
  <section class="seccion">
    <div class="contenedor">
      <div class="encabezado-seccion aparece">
        <span class="kicker">Apoyos</span>
        <h2>Programa de becas</h2>
        <p>Reconocemos el esfuerzo y apoyamos a las familias con distintos esquemas.</p>
      </div>
      <div class="grid grid--3">
        <div class="tarjeta aparece">
          <div class="icono">🏆</div>
          <h3>Beca de excelencia</h3>
          <p>Para alumnos con promedio destacado. Aplica desde el ingreso y se mantiene por desempeño.</p>
        </div>
        <div class="tarjeta aparece">
          <div class="icono">💛</div>
          <h3>Beca de apoyo socioeconómico</h3>
          <p>Dirigida a familias que requieren respaldo, previa evaluación de su situación.</p>
        </div>
        <div class="tarjeta aparece">
          <div class="icono">👨‍👩‍👧‍👦</div>
          <h3>Beca por hermanos</h3>
          <p>Descuento especial cuando dos o más hermanos estudian con nosotros.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="seccion seccion--azul">
    <div class="contenedor cta">
      <div class="aparece">
        <h2>¿Tienes dudas sobre el proceso?</h2>
        <p>Escríbenos a {sitio.emailAdmisiones} o llámanos al {sitio.telefono}.</p>
      </div>
      <div class="aparece">
        <a href="/contacto" class="btn btn--primario">Contactar admisiones</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(150deg, var(--azul-900), var(--azul-700));
    color: #fff;
    padding-block: clamp(3rem, 7vw, 4.5rem);
    text-align: center;
  }
  .page-hero .kicker {
    color: var(--acento);
    font-family: var(--fuente-titulo);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.82rem;
  }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 5vw, 3rem); margin: 0.6rem 0 0.8rem; }
  .page-hero p { color: rgba(255,255,255,0.88); max-width: 56ch; margin-inline: auto; font-size: 1.08rem; }
  .page-hero__acciones { display: flex; gap: 0.85rem; justify-content: center; flex-wrap: wrap; margin-top: 1.75rem; }

  /* Pasos */
  .pasos { list-style: none; padding: 0; max-width: 760px; margin-inline: auto; display: grid; gap: 1.1rem; }
  .paso {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: #fff;
    border: 1px solid var(--gris-200);
    border-radius: var(--radio);
    padding: 1.5rem;
    transition: box-shadow var(--transicion), border-color var(--transicion);
  }
  .paso:hover { box-shadow: var(--sombra-sm); border-color: var(--azul-300); }
  .paso__num {
    flex: none;
    width: 44px; height: 44px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--azul-700);
    color: #fff;
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .paso h3 { font-size: 1.15rem; margin-bottom: 0.25rem; }
  .paso p { color: var(--gris-700); }

  /* Listas y tablas */
  .bloques .tarjeta { padding: 2rem; }
  .lista-check { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .lista-check li { padding-left: 1.7rem; position: relative; color: var(--gris-700); }
  .lista-check li::before { content: "✓"; position: absolute; left: 0; color: var(--azul-500); font-weight: 700; }

  .tabla-fechas { width: 100%; border-collapse: collapse; }
  .tabla-fechas td { padding: 0.7rem 0; border-bottom: 1px solid var(--gris-200); font-size: 0.96rem; }
  .tabla-fechas td:first-child { color: var(--tinta); font-weight: 500; }
  .tabla-fechas td:last-child { color: var(--azul-600); text-align: right; white-space: nowrap; }
  .nota { font-size: 0.82rem; color: var(--gris-400); margin-top: 1rem; }

  .cta { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .cta h2 { font-size: clamp(1.5rem, 3.5vw, 2rem); }
  .cta p { color: rgba(255,255,255,0.85); margin-top: 0.4rem; }
</style>
